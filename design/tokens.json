{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "NEXUS Design Tokens",
  "version": "1.0.0",
  "description": "Editorial Mission Control theme — Light mode",
  "color": {
    "global": {
      "oat": {
        "50":  { "value": "#F9F7F2" },
        "100": { "value": "#F2EEE5", "description": "Canvas (page background)" },
        "200": { "value": "#E9E4D8", "description": "Sunken panels" },
        "300": { "value": "#D9D2C2", "description": "Borders" },
        "400": { "value": "#C4BAA6" },
        "500": { "value": "#A99E8A" }
      },
      "cream": {
        "50":  { "value": "#FDFCFA" },
        "100": { "value": "#FBF9F4", "description": "Surface (cards)" },
        "200": { "value": "#F5F1E9" },
        "300": { "value": "#EDE7DA" }
      },
      "ink": {
        "900": { "value": "#1E2A32", "description": "Primary text" },
        "700": { "value": "#364650" },
        "500": { "value": "#5E6B72", "description": "Muted text" },
        "400": { "value": "#7A8790" },
        "300": { "value": "#9BA5AC" },
        "200": { "value": "#C2CAD0" }
      },
      "teal": {
        "900": { "value": "#063D3D" },
        "800": { "value": "#0A5656", "description": "Primary hover" },
        "700": { "value": "#0E6B6B", "description": "Primary" },
        "600": { "value": "#148080" },
        "500": { "value": "#1A9494" },
        "400": { "value": "#3DB5B5" },
        "300": { "value": "#7CD4D4" },
        "200": { "value": "#B3E6E6" },
        "100": { "value": "#D7ECE9", "description": "Primary tint" },
        "50":  { "value": "#EBF5F3" }
      },
      "saffron": {
        "900": { "value": "#7A4E0B" },
        "800": { "value": "#A56810" },
        "700": { "value": "#C47D1B" },
        "600": { "value": "#E9A23B", "description": "Human attention / waiting" },
        "500": { "value": "#F0B556" },
        "400": { "value": "#F5C97A" },
        "300": { "value": "#F9DDA3" },
        "200": { "value": "#FCF0D0" },
        "100": { "value": "#FEF7E8" },
        "50":  { "value": "#FFFBF3" }
      },
      "blue": {
        "800": { "value": "#1F3F8C" },
        "700": { "value": "#2B51AE" },
        "600": { "value": "#3563C9", "description": "Running / info" },
        "500": { "value": "#4F7DDC" },
        "400": { "value": "#7A9DE8" },
        "200": { "value": "#C2D4F4" },
        "100": { "value": "#E0EAFA" },
        "50":  { "value": "#F0F5FD" }
      },
      "green": {
        "800": { "value": "#1E5E3A" },
        "700": { "value": "#257548" },
        "600": { "value": "#2E8B57", "description": "Success" },
        "500": { "value": "#3DA36C" },
        "400": { "value": "#65BF90" },
        "200": { "value": "#B5DFC9" },
        "100": { "value": "#DAEEE2" },
        "50":  { "value": "#EDF7F1" }
      },
      "red": {
        "800": { "value": "#8C2C24" },
        "700": { "value": "#A83830" },
        "600": { "value": "#C8453B", "description": "Danger / failed" },
        "500": { "value": "#D86054" },
        "400": { "value": "#E58880" },
        "200": { "value": "#F4C9C5" },
        "100": { "value": "#FAE4E2" },
        "50":  { "value": "#FDF2F1" }
      },
      "coral": {
        "600": { "value": "#E8735A", "description": "AI accent" },
        "100": { "value": "#FCEAE4" }
      }
    },
    "semantic": {
      "canvas":         { "value": "{color.global.oat.100}" },
      "surface":        { "value": "{color.global.cream.100}" },
      "surfaceRaised":  { "value": "{color.global.cream.50}" },
      "surfaceSunken":  { "value": "{color.global.oat.200}" },
      "border":         { "value": "{color.global.oat.300}" },
      "borderSubtle":   { "value": "{color.global.oat.200}" },
      "textPrimary":    { "value": "{color.global.ink.900}" },
      "textSecondary":  { "value": "{color.global.ink.500}" },
      "textOnPrimary":  { "value": "#FFFFFF" },
      "primary":        { "value": "{color.global.teal.700}" },
      "primaryHover":   { "value": "{color.global.teal.800}" },
      "primaryTint":    { "value": "{color.global.teal.100}" },
      "statusDone":     { "value": "{color.global.green.600}" },
      "statusRunning":  { "value": "{color.global.blue.600}" },
      "statusWaiting":  { "value": "{color.global.saffron.600}" },
      "statusFailed":   { "value": "{color.global.red.600}" },
      "aiAccent":       { "value": "{color.global.coral.600}" }
    }
  },
  "typography": {
    "fontFamily": {
      "heading": { "value": "'Source Serif 4', Georgia, serif" },
      "body":    { "value": "'Inter', -apple-system, sans-serif" },
      "mono":    { "value": "'JetBrains Mono', 'Fira Code', monospace" }
    },
    "scale": {
      "display": { "size": "2.25rem", "lineHeight": "1.2", "weight": "700", "font": "heading" },
      "h1":      { "size": "1.75rem", "lineHeight": "1.25", "weight": "700", "font": "heading" },
      "h2":      { "size": "1.375rem", "lineHeight": "1.3", "weight": "600", "font": "heading" },
      "h3":      { "size": "1.125rem", "lineHeight": "1.35", "weight": "600", "font": "heading" },
      "body":    { "size": "0.9375rem", "lineHeight": "1.6", "weight": "400", "font": "body" },
      "sm":      { "size": "0.8125rem", "lineHeight": "1.5", "weight": "400", "font": "body" },
      "xs":      { "size": "0.6875rem", "lineHeight": "1.45", "weight": "500", "font": "body" },
      "mono":    { "size": "0.8125rem", "lineHeight": "1.5", "weight": "400", "font": "mono" },
      "stat":    { "size": "2.5rem", "lineHeight": "1.1", "weight": "700", "font": "body" }
    }
  },
  "spacing": {
    "0":    { "value": "0" },
    "0.5":  { "value": "2px" },
    "1":    { "value": "4px" },
    "1.5":  { "value": "6px" },
    "2":    { "value": "8px" },
    "3":    { "value": "12px" },
    "4":    { "value": "16px" },
    "5":    { "value": "20px" },
    "6":    { "value": "24px" },
    "8":    { "value": "32px" },
    "10":   { "value": "40px" },
    "12":   { "value": "48px" },
    "16":   { "value": "64px" }
  },
  "borderRadius": {
    "none": { "value": "0" },
    "sm":   { "value": "4px" },
    "md":   { "value": "8px" },
    "lg":   { "value": "12px" },
    "xl":   { "value": "16px" },
    "full": { "value": "9999px" }
  },
  "shadow": {
    "none": { "value": "none" },
    "xs":   { "value": "0 1px 2px rgba(30,42,50,0.04)" },
    "sm":   { "value": "0 1px 3px rgba(30,42,50,0.06), 0 1px 2px rgba(30,42,50,0.04)" },
    "md":   { "value": "0 4px 6px rgba(30,42,50,0.06), 0 2px 4px rgba(30,42,50,0.04)" },
    "lg":   { "value": "0 10px 15px rgba(30,42,50,0.06), 0 4px 6px rgba(30,42,50,0.04)" },
    "xl":   { "value": "0 20px 25px rgba(30,42,50,0.08), 0 8px 10px rgba(30,42,50,0.04)" }
  },
  "motion": {
    "duration": {
      "instant":    { "value": "0ms" },
      "fast":       { "value": "100ms" },
      "normal":     { "value": "200ms" },
      "slow":       { "value": "300ms" },
      "deliberate": { "value": "500ms" }
    },
    "easing": {
      "out":    { "value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "in":     { "value": "cubic-bezier(0.7, 0, 0.84, 0)" },
      "inOut":  { "value": "cubic-bezier(0.45, 0, 0.55, 1)" },
      "spring": { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)" }
    }
  }
}
