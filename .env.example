# =============================================================================
# NEXUS — Environment Variables
# Copy to .env and fill in your values. Never commit .env to version control.
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
# development | staging | production
NEXUS_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
# Comma-separated origins allowed for CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Database (PostgreSQL 16 + pgvector) ──────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev
POSTGRES_DB=nexus_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nexus:nexus_dev@postgres:5432/nexus_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ── Redis 7 ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# ── Auth (JWT) ───────────────────────────────────────────────────────────────
# IMPORTANT: Generate a secure key for staging/production:
#   openssl rand -hex 64
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Object Storage (MinIO / S3) ─────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nexus-uploads
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Email (Mailpit for local dev) ────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nexus.local

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Sentry (optional — leave empty to disable) ──────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Feature Flags ────────────────────────────────────────────────────────────
SANDBOX_DEMO_MODE=false
SANDBOX_CHAOS_MODE=false

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_USER=100
RATE_LIMIT_PER_IP=200

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=NEXUS
