{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total LLM Cost (USD Today)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(nexus_llm_cost_usd_total[24h]))",
          "legendFormat": "USD",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyUSD"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Token Consumption (Last Hour)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(nexus_llm_tokens_total[1h]))",
          "legendFormat": "Tokens",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "LLM Latency (p95 ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nexus_llm_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "p95 ms",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2000 },
              { "color": "red", "value": 4000 }
            ]
          },
          "unit": "ms"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Budget Utilization %",
      "type": "gauge",
      "targets": [
        {
          "expr": "(nexus_llm_cost_usd_total / nexus_llm_monthly_budget_usd) * 100",
          "legendFormat": "Budget %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percent"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "LLM Cost Rate by Model & Tier (USD/hour)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (model, tier) (rate(nexus_llm_cost_usd_total[1h])) * 3600",
          "legendFormat": "{{model}} ({{tier}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "LLM Latency Distribution by Provider (Gemini / Anthropic / Local)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (provider, le) (rate(nexus_llm_request_duration_seconds_bucket[5m]))) * 1000",
          "legendFormat": "{{provider}} p95 ms",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["nexus", "llm", "cost", "latency", "ai"],
  "time": { "from": "now-6h", "to": "now" },
  "title": "Nexus — LLM Cost, Tokens & Latency Monitoring",
  "uid": "nexus-llm-cost-latency"
}
